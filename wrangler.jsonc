{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafenetyar-temp",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafenetyar-temp",
      "migrations_dir": "drizzle"
    }
  ],
  "keep_vars": true
}
